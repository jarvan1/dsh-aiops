{
  "name": "dsh-aiops",
  "description": "Git-installable DSH bundle for general read-only incident diagnosis",
  "version": "0.1.2-rc.1",
  "type": "module",
  "main": "packages/aiops/lib/index.js",
  "exports": {
    ".": "./packages/aiops/lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "packages/*/lib/**/*.js",
    "packages/*/lib/**/*.js.map",
    "packages/*/package.json",
    "packages/skill-k8s-diag/skills/**"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarvan1/dsh-aiops.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "aiops",
    "alertmanager",
    "prometheus",
    "kubernetes"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm run clean && tsc -p packages/aiops-http-read && tsc -p packages/aiops-observability && tsc -p packages/aiops-alertmanager && tsc -p packages/aiops-prometheus && tsc -p packages/aiops-kubernetes && tsc -p packages/aiops-incident && tsc -p packages/tool-aiops-observe && tsc -p packages/webhook-alertmanager && tsc -p packages/incident-router && tsc -p packages/tool-aiops-history && tsc -p packages/aiops-portal && node scripts/build-portal.mjs && tsc -p packages/skill-k8s-diag && tsc -p packages/aiops",
    "build:github": "pnpm run build && node scripts/prepare-github.mjs",
    "typecheck": "pnpm run build",
    "test": "pnpm run build && vitest run",
    "docs:check": "node scripts/check-links.mjs",
    "e2e:k3s:setup": "node scripts/aiops-e2e.mjs setup",
    "e2e:k3s:exercise": "node scripts/aiops-e2e.mjs exercise",
    "e2e:k3s:verify": "node scripts/aiops-e2e.mjs verify",
    "e2e:k3s:seed-restart": "node scripts/aiops-e2e.mjs seed-restart",
    "e2e:k3s:verify-restart": "node scripts/aiops-e2e.mjs verify-restart",
    "e2e:k3s:cleanup": "node scripts/aiops-e2e.mjs cleanup",
    "pack:bundle": "pnpm --filter @deepseek-ai/dsh-aiops pack",
    "prepare": "pnpm run build:github"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-brand": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-permission-presets": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-query": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-query-sqlite": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-title": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-util-values": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-webhook": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@kubernetes/client-node": "2.0.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "22.20.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
