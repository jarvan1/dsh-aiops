{
  "name": "@deepseek-ai/dsh-aiops",
  "description": "Installable DSH bundle for storm-controlled read-only diagnosis, feedback, and history",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-aiops-alertmanager": "workspace:^",
    "@deepseek-ai/dsh-aiops-incident": "workspace:^",
    "@deepseek-ai/dsh-aiops-incident-router": "workspace:^",
    "@deepseek-ai/dsh-aiops-kubernetes": "workspace:^",
    "@deepseek-ai/dsh-aiops-observability": "workspace:^",
    "@deepseek-ai/dsh-aiops-portal": "workspace:^",
    "@deepseek-ai/dsh-aiops-prometheus": "workspace:^",
    "@deepseek-ai/dsh-aiops-skill-k8s-diag": "workspace:^",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-query-sqlite": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tool-aiops-history": "workspace:^",
    "@deepseek-ai/dsh-tool-aiops-observe": "workspace:^",
    "@deepseek-ai/dsh-webhook": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-webhook-alertmanager": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
