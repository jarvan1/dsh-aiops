{
  "name": "@deepseek-ai/dsh-aiops-agents",
  "description": "Cluster agent registry, server-issued tokens, and the WebSocket read gateway for DSH AIOps",
  "version": "0.2.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/gateway.js",
    "lib/store.js",
    "lib/tokens.js",
    "lib/types.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "peerDependencies": {
